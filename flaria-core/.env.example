# Copy to flaria-core/.env. Every variable is prefixed FLARIA_ (see app/core/config.py).
FLARIA_ENV=production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
FLARIA_JWT_SECRET=
FLARIA_COOKIE_SECURE=true
FLARIA_CORS_ORIGINS=["https://flaria.example.org"]
# Public host(s) nginx forwards, plus localhost for the container health check.
FLARIA_TRUSTED_HOSTS=["flaria.example.org","localhost","127.0.0.1"]
FLARIA_LOG_LEVEL=INFO
FLARIA_TICK_HZ=30
FLARIA_TICK_ENCODING=json
FLARIA_INFERENCE_THREADS=4
FLARIA_AUTO_MIGRATE=true
# FLARIA_DATABASE_URL is set by docker-compose.yml

# Password reset e-mails (production requires smtp and an https public URL)
FLARIA_PUBLIC_APP_URL=https://flaria.example.org
FLARIA_MAIL_BACKEND=smtp
FLARIA_MAIL_FROM=Flaria <no-reply@flaria.example.org>
FLARIA_SMTP_HOST=smtp.example.org
FLARIA_SMTP_PORT=587
FLARIA_SMTP_STARTTLS=true
FLARIA_SMTP_USERNAME=
FLARIA_SMTP_PASSWORD=
FLARIA_PASSWORD_RESET_TTL_MINUTES=30
