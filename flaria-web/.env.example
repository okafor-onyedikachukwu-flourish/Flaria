# Dev proxy target for /api, /health and /ws (vite.config.ts)
FLARIA_API_TARGET=http://127.0.0.1:8000
# Override only when the API is not served from the same origin as the app.
# VITE_API_BASE=https://api.example.org/api/v1
# VITE_WS_URL=wss://api.example.org/ws/stream
# MediaPipe runtime and model are self-hosted by default (npm install + npm run assets).
# VITE_MEDIAPIPE_WASM_BASE=/mediapipe/wasm
# VITE_FACE_MODEL_URL=/mediapipe/face_landmarker.task

# Search and sharing (used by `npm run build`)
VITE_SITE_URL=https://flaria.example.org
# FLARIA_SAME_AS=https://github.com/your-org,https://www.linkedin.com/company/your-org
# FLARIA_GOOGLE_SITE_VERIFICATION=token-from-google-search-console
# FLARIA_BING_SITE_VERIFICATION=token-from-bing-webmaster-tools
