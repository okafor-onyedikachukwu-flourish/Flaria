{
  "name": "flaria-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "postinstall": "node scripts/copy-mediapipe.mjs",
    "assets": "node scripts/fetch-assets.mjs",
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "npm run typecheck && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.1.0",
    "@fontsource/ibm-plex-sans-condensed": "5.1.0",
    "@mediapipe/tasks-vision": "0.10.14",
    "axios": "1.7.7",
    "chart.js": "4.4.6",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-chartjs-2": "5.2.0",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
